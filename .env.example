# API
PORT=4000
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://bellwether:bellwether@localhost:5432/bellwether
# Separate database for the Postgres repository tests (created by docker compose)
TEST_DATABASE_URL=postgresql://bellwether:bellwether@localhost:5432/bellwether_test

# External APIs (free, no keys needed)
POSTCODES_API_BASE=https://api.postcodes.io
WEATHER_API_BASE=https://api.open-meteo.com
WEATHER_ARCHIVE_API_BASE=https://archive-api.open-meteo.com

# Set to "debug" to see cache hits/misses
LOG_LEVEL=info

# Briefing emails (FR-4.3). Mailpit from docker compose catches them; inbox at http://localhost:8125
SMTP_URL=smtp://localhost:1125
EMAIL_FROM=Bellwether <briefing@bellwether.local>
# Where links in emails point
APP_URL=http://localhost:5173
# How often the briefing job runs (minutes); 0 turns it off
BRIEFING_JOB_MINUTES=5
# "Explore a demo account" on the login page; set to off to turn it off
DEMO_ACCOUNTS=on
