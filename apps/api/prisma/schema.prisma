// Farm data model (FR-2). Every record carries farmId (FR-2.7) so access can be scoped per farm.
// Pets and their logs belong to a user (FR-2.6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Species {
  CATTLE
  SHEEP
}

enum LivestockClass {
  EWES
  LAMBS
  RAMS
  DAIRY_COWS
  BEEF_CATTLE
  CALVES
}

enum CattleType {
  DAIRY
  BEEF
}

// --- Users and sessions (FR-8.1) ---

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Trimmed and lower-cased before it gets here (A12)
  email        String   @unique
  // scrypt$N$r$p$salt$hash (A9)
  passwordHash String
  createdAt    DateTime @default(now())

  sessions       Session[]
  memberships    FarmMember[]
  briefingPrefs  BriefingPreference[]
  briefingEmails BriefingEmail[]
  pets           Pet[]
  revisions      RecordRevision[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  // SHA-256 of the cookie token; the token itself is never stored (A10)
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Worker and Viewer permissions arrive with FR-8.2 (A13)
enum FarmRole {
  OWNER
  WORKER
  VIEWER
}

model FarmMember {
  farmId    String   @db.Uuid
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      FarmRole
  createdAt DateTime @default(now())

  @@id([farmId, userId])
  @@index([userId])
}

// --- Farms (FR-2) ---

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  postcode  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        FarmMember[]
  fields         Field[]
  groups         LivestockGroup[]
  movements      GroupMovement[]
  treatments     Treatment[]
  observations   Observation[]
  tasks          Task[]
  revisions      RecordRevision[]
  briefingRuns   BriefingRun[]
  briefingPrefs  BriefingPreference[]
  briefingEmails BriefingEmail[]
}

model Field {
  id        String   @id @default(uuid()) @db.Uuid
  farmId    String   @db.Uuid
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name      String
  postcode  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  currentGroups LivestockGroup[] @relation("CurrentField")
  movesFrom     GroupMovement[]  @relation("FromField")
  movesTo       GroupMovement[]  @relation("ToField")

  @@index([farmId])
}

model LivestockGroup {
  id             String         @id @default(uuid()) @db.Uuid
  farmId         String         @db.Uuid
  farm           Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name           String
  species        Species
  livestockClass LivestockClass
  headCount      Int
  currentFieldId String?        @db.Uuid
  currentField   Field?         @relation("CurrentField", fields: [currentFieldId], references: [id], onDelete: SetNull)
  housed         Boolean        @default(false)

  // Sheep only
  lastShearingDate       DateTime? @db.Date
  lambingStart           DateTime? @db.Date
  lambingEnd             DateTime? @db.Date
  lambsAtGrassThisSpring Boolean   @default(false)

  // Cattle only
  cattleType   CattleType?
  calvingStart DateTime?   @db.Date
  calvingEnd   DateTime?   @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements    GroupMovement[]
  treatments   Treatment[]
  observations Observation[]
  tasks        Task[]

  @@index([farmId])
}

model GroupMovement {
  id          String         @id @default(uuid()) @db.Uuid
  // Insertion order, to break ties between moves on the same day
  seq         Int            @default(autoincrement())
  farmId      String         @db.Uuid
  farm        Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  groupId     String         @db.Uuid
  group       LivestockGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromFieldId String?        @db.Uuid
  fromField   Field?         @relation("FromField", fields: [fromFieldId], references: [id], onDelete: SetNull)
  toFieldId   String         @db.Uuid
  toField     Field          @relation("ToField", fields: [toFieldId], references: [id], onDelete: Cascade)
  movedOn     DateTime       @db.Date
  createdAt   DateTime       @default(now())

  @@index([groupId, movedOn])
}

// --- Records (FR-6) ---
// No delete: records are never hard-deleted. Corrections and voids keep a RecordRevision (FR-6.5).

model Treatment {
  id                 String         @id @default(uuid()) @db.Uuid
  // Insertion order, to break ties between records on the same day
  seq                Int            @default(autoincrement())
  farmId             String         @db.Uuid
  farm               Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  groupId            String         @db.Uuid
  group              LivestockGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date               DateTime       @db.Date
  // Typed by the farmer from the label; never suggested by Bellwether
  productName        String
  batchNumber        String?
  quantityUsed       String?
  animalsTreated     Int
  administeredBy     String
  reason             String?
  // Copied by the farmer from the product label or vet instructions (FR-6.3)
  meatWithdrawalDays Int
  milkWithdrawalDays Int?
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime       @default(now())

  @@index([groupId, date])
  @@index([farmId, date])
}

model Observation {
  id         String         @id @default(uuid()) @db.Uuid
  seq        Int            @default(autoincrement())
  farmId     String         @db.Uuid
  farm       Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  groupId    String         @db.Uuid
  group      LivestockGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date       DateTime       @db.Date
  type       String
  note       String?
  voidedAt   DateTime?
  voidReason String?
  createdAt  DateTime       @default(now())

  @@index([groupId, date])
}

// FR-6.5: one correction or void of a treatment or observation. Append-only.
model RecordRevision {
  id           String   @id @default(uuid()) @db.Uuid
  seq          Int      @default(autoincrement())
  farmId       String   @db.Uuid
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  // 'TREATMENT' or 'OBSERVATION'
  recordType   String
  recordId     String   @db.Uuid
  // 'EDITED' or 'VOIDED'
  action       String
  reason       String
  editedById   String?  @db.Uuid
  editedByUser User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)
  // The editor's email at the time, kept even if the account goes
  editedBy     String
  editedAt     DateTime
  // [{ field, from, to }]
  changes      Json

  @@index([recordId])
}

// --- Tasks and briefings (FR-5, FR-4) ---

model Task {
  id              String          @id @default(uuid()) @db.Uuid
  seq             Int             @default(autoincrement())
  farmId          String          @db.Uuid
  farm            Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  // Null for a farm-wide task (FR-5.3)
  groupId         String?         @db.Uuid
  group           LivestockGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title           String
  dueDate         DateTime        @db.Date
  note            String?
  done            Boolean         @default(false)
  // FR-5.3: repeats this many days after its due date once done
  repeatEveryDays Int?
  // The follow-up made when a repeating task was done, so it's only made once
  nextTaskId      String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([farmId, dueDate])
}

// One stored briefing per farm per UK date (FR-4.5)
model BriefingRun {
  id          String   @id @default(uuid()) @db.Uuid
  farmId      String   @db.Uuid
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  generatedAt DateTime
  content     Json
  createdAt   DateTime @default(now())

  @@unique([farmId, date])
}

// Per user, per farm email settings (FR-4.3)
model BriefingPreference {
  farmId       String  @db.Uuid
  farm         Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId       String  @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled Boolean @default(true)
  // HH:MM, Europe/London
  sendAt       String  @default("06:00")
  alwaysSend   Boolean @default(false)

  @@id([farmId, userId])
}

// One row per user per farm per day, claimed before sending so an email goes out at most once
model BriefingEmail {
  farmId    String   @db.Uuid
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@id([farmId, userId, date])
}

// --- Pets (FR-2.6) ---

model Pet {
  id                  String   @id @default(uuid()) @db.Uuid
  seq                 Int      @default(autoincrement())
  ownerId             String   @db.Uuid
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  species             String
  // 'pet' or 'farm', as in the risk engine
  category            String   @default("pet")
  // Normalised UK postcode for the pet's own forecast
  postcode            String?
  highExposureHabitat Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  logs PetLogEntry[]

  @@index([ownerId])
}

model PetLogEntry {
  id          String    @id @default(uuid()) @db.Uuid
  seq         Int       @default(autoincrement())
  petId       String    @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  type        String
  note        String?
  nextDueDate DateTime? @db.Date
  createdAt   DateTime  @default(now())

  @@index([petId, date])
}
