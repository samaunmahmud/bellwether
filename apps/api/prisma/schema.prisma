// Farm data model (FR-2). Every record carries farmId (FR-2.7) so access can be scoped per farm.
// Pets and their logs belong to a user (FR-2.6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Species {
  CATTLE
  SHEEP
}

enum LivestockClass {
  EWES
  LAMBS
  RAMS
  DAIRY_COWS
  BEEF_CATTLE
  CALVES
}

enum CattleType {
  DAIRY
  BEEF
}

// --- Users and sessions (FR-8.1) ---

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Trimmed and lower-cased before it gets here (A12)
  email        String   @unique
  // scrypt$N$r$p$salt$hash (A9)
  passwordHash String
  createdAt    DateTime @default(now())

  sessions       Session[]
  memberships    FarmMember[]
  briefingPrefs  BriefingPreference[]
  briefingEmails BriefingEmail[]
  pets           Pet[]
  petReminders   PetReminderEmail[]
  contacts       Contact[]
  revisions      RecordRevision[]
  invitesSent    FarmInvite[]
  assignedTasks  Task[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  // SHA-256 of the cookie token; the token itself is never stored (A10)
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// FR-8.2: OWNER manages, WORKER does day-to-day work, VIEWER can only look
enum FarmRole {
  OWNER
  WORKER
  VIEWER
}

model FarmMember {
  farmId    String   @db.Uuid
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      FarmRole
  createdAt DateTime @default(now())

  @@id([farmId, userId])
  @@index([userId])
}

// FR-8.2: matched to whoever signs in with this email
model FarmInvite {
  id          String   @id @default(uuid()) @db.Uuid
  farmId      String   @db.Uuid
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  // Trimmed and lower-cased
  email       String
  role        FarmRole
  invitedById String?  @db.Uuid
  invitedBy   User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([farmId, email])
  @@index([email])
}

// --- Farms (FR-2) ---

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  postcode  String
  // v3 holding details: County Parish Holding number and flock/herd mark
  cphNumber String?
  flockMark String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        FarmMember[]
  registerEvents RegisterEvent[]
  medicines      MedicineItem[]
  invites        FarmInvite[]
  fields         Field[]
  groups         LivestockGroup[]
  movements      GroupMovement[]
  treatments     Treatment[]
  observations   Observation[]
  tasks          Task[]
  revisions      RecordRevision[]
  briefingRuns   BriefingRun[]
  briefingPrefs  BriefingPreference[]
  briefingEmails BriefingEmail[]
  contacts       Contact[]
  taggedAnimals  TaggedAnimal[]
}

model Field {
  id         String    @id @default(uuid()) @db.Uuid
  farmId     String    @db.Uuid
  farm       Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name       String
  postcode   String?
  latitude   Float?
  longitude  Float?
  // Archived fields keep their history but take no new moves
  archivedOn DateTime? @db.Date
  createdAt  DateTime  @default(now())

  currentGroups LivestockGroup[] @relation("CurrentField")
  movesFrom     GroupMovement[]  @relation("FromField")
  movesTo       GroupMovement[]  @relation("ToField")

  @@index([farmId])
}

model LivestockGroup {
  id             String         @id @default(uuid()) @db.Uuid
  farmId         String         @db.Uuid
  farm           Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name           String
  species        Species
  livestockClass LivestockClass
  headCount      Int
  currentFieldId String?        @db.Uuid
  currentField   Field?         @relation("CurrentField", fields: [currentFieldId], references: [id], onDelete: SetNull)
  housed         Boolean        @default(false)

  // Sheep only
  lastShearingDate       DateTime? @db.Date
  lambingStart           DateTime? @db.Date
  lambingEnd             DateTime? @db.Date
  lambsAtGrassThisSpring Boolean   @default(false)

  // Cattle only
  cattleType   CattleType?
  calvingStart DateTime?   @db.Date
  calvingEnd   DateTime?   @db.Date

  // Sold or finished: records are kept, briefings skip it
  archivedOn    DateTime? @db.Date
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements      GroupMovement[]
  treatments     Treatment[]
  observations   Observation[]
  tasks          Task[]
  taggedAnimals  TaggedAnimal[]
  registerEvents RegisterEvent[]

  @@index([farmId])
}

model GroupMovement {
  id          String         @id @default(uuid()) @db.Uuid
  // Insertion order, to break ties between moves on the same day
  seq         Int            @default(autoincrement())
  farmId      String         @db.Uuid
  farm        Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  groupId     String         @db.Uuid
  group       LivestockGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromFieldId String?        @db.Uuid
  fromField   Field?         @relation("FromField", fields: [fromFieldId], references: [id], onDelete: SetNull)
  toFieldId   String         @db.Uuid
  toField     Field          @relation("ToField", fields: [toFieldId], references: [id], onDelete: Cascade)
  movedOn     DateTime       @db.Date
  createdAt   DateTime       @default(now())

  @@index([groupId, movedOn])
}

// --- Records (FR-6) ---
// No delete: records are never hard-deleted. Corrections and voids keep a RecordRevision (FR-6.5).

model Treatment {
  id                 String         @id @default(uuid()) @db.Uuid
  // Insertion order, to break ties between records on the same day
  seq                Int            @default(autoincrement())
  farmId             String         @db.Uuid
  farm               Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  groupId            String         @db.Uuid
  group              LivestockGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date               DateTime       @db.Date
  // Typed by the farmer from the label; never suggested by Bellwether
  productName        String
  batchNumber        String?
  quantityUsed       String?
  animalsTreated     Int
  administeredBy     String
  reason             String?
  // Copied by the farmer from the product label or vet instructions (FR-6.3)
  meatWithdrawalDays Int
  milkWithdrawalDays Int?
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime       @default(now())

  @@index([groupId, date])
  @@index([farmId, date])
}

model Observation {
  id         String         @id @default(uuid()) @db.Uuid
  seq        Int            @default(autoincrement())
  farmId     String         @db.Uuid
  farm       Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  groupId    String         @db.Uuid
  group      LivestockGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date       DateTime       @db.Date
  type       String
  note       String?
  voidedAt   DateTime?
  voidReason String?
  createdAt  DateTime       @default(now())

  @@index([groupId, date])
}

// FR-6.5: one correction or void of a treatment or observation. Append-only.
model RecordRevision {
  id           String   @id @default(uuid()) @db.Uuid
  seq          Int      @default(autoincrement())
  farmId       String   @db.Uuid
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  // 'TREATMENT' or 'OBSERVATION'
  recordType   String
  recordId     String   @db.Uuid
  // 'EDITED' or 'VOIDED'
  action       String
  reason       String
  editedById   String?  @db.Uuid
  editedByUser User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)
  // The editor's email at the time, kept even if the account goes
  editedBy     String
  editedAt     DateTime
  // [{ field, from, to }]
  changes      Json

  @@index([recordId])
}

// --- Tasks and briefings (FR-5, FR-4) ---

model Task {
  id              String          @id @default(uuid()) @db.Uuid
  seq             Int             @default(autoincrement())
  farmId          String          @db.Uuid
  farm            Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  // Null for a farm-wide task (FR-5.3)
  groupId         String?         @db.Uuid
  group           LivestockGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title           String
  dueDate         DateTime        @db.Date
  note            String?
  done            Boolean         @default(false)
  // FR-5.3: repeats this many days after its due date once done
  repeatEveryDays Int?
  // The follow-up made when a repeating task was done, so it's only made once
  nextTaskId      String?         @db.Uuid
  // FR-5.4: a farm member
  assigneeId      String?         @db.Uuid
  assignee        User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([farmId, dueDate])
}

// One stored briefing per farm per UK date (FR-4.5)
model BriefingRun {
  id          String   @id @default(uuid()) @db.Uuid
  farmId      String   @db.Uuid
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  generatedAt DateTime
  content     Json
  createdAt   DateTime @default(now())

  @@unique([farmId, date])
}

// Per user, per farm email settings (FR-4.3)
model BriefingPreference {
  farmId       String  @db.Uuid
  farm         Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId       String  @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled Boolean @default(true)
  // HH:MM, Europe/London
  sendAt       String  @default("06:00")
  alwaysSend   Boolean @default(false)

  @@id([farmId, userId])
}

// One row per user per farm per day, claimed before sending so an email goes out at most once
model BriefingEmail {
  farmId    String   @db.Uuid
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@id([farmId, userId, date])
}

// --- Pets (FR-2.6) ---

model Pet {
  id                  String   @id @default(uuid()) @db.Uuid
  seq                 Int      @default(autoincrement())
  ownerId             String   @db.Uuid
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  species             String
  // 'pet' or 'farm', as in the risk engine
  category            String   @default("pet")
  // Normalised UK postcode for the pet's own forecast
  postcode            String?
  highExposureHabitat Boolean  @default(false)
  // v4: details for the pet's record
  dateOfBirth         DateTime? @db.Date
  breed               String?
  sex                 String?
  microchip           String?
  // v3: email the owner when health-plan items fall due
  remindersEnabled    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  logs PetLogEntry[]

  @@index([ownerId])
}

model PetLogEntry {
  id          String    @id @default(uuid()) @db.Uuid
  seq         Int       @default(autoincrement())
  petId       String    @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  type        String
  note        String?
  nextDueDate DateTime? @db.Date
  // v3: weight on the day, for the pet's weight chart
  weightKg    Float?
  createdAt   DateTime  @default(now())

  @@index([petId, date])
}

// --- v3: holding register and medicine cabinet ---

enum RegisterEventKind {
  BIRTH
  DEATH
  MOVE_ON
  MOVE_OFF
  WEIGHING
  FEC
  BODY_CONDITION
  TAG_REPLACEMENT
  HEAD_COUNT
}

// Births, deaths, moves on/off the holding and measurements. Voided, never deleted.
model RegisterEvent {
  id         String            @id @default(uuid()) @db.Uuid
  seq        Int               @default(autoincrement())
  farmId     String            @db.Uuid
  farm       Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  groupId    String            @db.Uuid
  group      LivestockGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind       RegisterEventKind
  date       DateTime          @db.Date
  count      Int?
  bornDead   Int?
  value      Float?
  otherParty String?
  reference  String?
  cause      String?
  note       String?
  recordedBy String
  recordedAt DateTime
  voidedAt   DateTime?
  voidReason String?

  @@index([farmId, date])
}

// Products on hand, typed by the farmer from the label
model MedicineItem {
  id                 String    @id @default(uuid()) @db.Uuid
  farmId             String    @db.Uuid
  farm               Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  productName        String
  batchNumber        String?
  quantity           String?
  expiryDate         DateTime? @db.Date
  supplier           String?
  purchasedOn        DateTime? @db.Date
  meatWithdrawalDays Int?
  milkWithdrawalDays Int?
  note               String?
  finishedOn         DateTime? @db.Date
  createdAt          DateTime  @default(now())

  @@index([farmId])
}

// v3: one row per owner per UK day, claimed before sending pet reminders so each goes out once
model PetReminderEmail {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@id([userId, date])
}

// v4: the people a farm or pet owner deals with (vets, feed merchants, suppliers)
enum ContactKind {
  VET
  FEED
  SUPPLIER
  OTHER
}

model Contact {
  id             String      @id @default(uuid()) @db.Uuid
  // Exactly one of farmId (shared with the farm's members) or ownerId (a user's own) is set
  farmId         String?     @db.Uuid
  farm           Farm?       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ownerId        String?     @db.Uuid
  owner          User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind           ContactKind
  name           String
  phone          String?
  emergencyPhone String?
  email          String?
  website        String?
  address        String?
  notes          String?
  createdAt      DateTime    @default(now())

  @@index([farmId])
  @@index([ownerId])
}

// v4: one animal with its own ear tag or ID, beside the group head counts
enum AnimalSex {
  FEMALE
  MALE
  CASTRATED
}

enum AnimalStatus {
  ON_FARM
  SOLD
  DIED
}

model TaggedAnimal {
  id          String          @id @default(uuid()) @db.Uuid
  seq         Int             @default(autoincrement())
  farmId      String          @db.Uuid
  farm        Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  groupId     String?         @db.Uuid
  group       LivestockGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tag         String
  // The tag without spaces, upper case: unique per farm
  tagKey      String
  name        String?
  species     Species
  sex         AnimalSex
  breed       String?
  dateOfBirth DateTime?       @db.Date
  status      AnimalStatus    @default(ON_FARM)
  statusDate  DateTime?       @db.Date
  notes       String?
  createdAt   DateTime        @default(now())

  @@unique([farmId, tagKey])
}
